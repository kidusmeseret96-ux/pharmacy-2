# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Set a strong 32+ character secret in production (Render / .exe).
SESSION_SECRET=

# OWNER_PASSCODE: Leave empty to allow interactive first-run owner claim & forgot-password recovery.
OWNER_PASSCODE=

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional PostgreSQL persistence via Supabase PostgREST.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# VENDOR_CLOUDFLARE_URL & VENDOR_SYNC_SECRET: Optional remote Cloudflare Vendor Registry URL for live anti-sharing & license status sync.
VENDOR_CLOUDFLARE_URL=
VENDOR_SYNC_SECRET=

# VENDOR_ADMIN_PASSCODE: Optional override for developer vendor portal login (defaults server-side).
VENDOR_ADMIN_PASSCODE=
